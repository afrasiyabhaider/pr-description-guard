{
  "manifest_version": 3,
  "name": "PR Description Guard",
  "version": "1.0.0",
  "description": "Validates GitHub PR descriptions for required sections",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*/compare/*",
        "*://github.com/*/pull/new/*",
        "*://github.com/*/pull/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "privacy_policy": "https://github.com/YOUR_USERNAME/pr-description-guard/blob/main/PRIVACY.md"
}
